---
/**
 * Page Expériences, partagée par /experiences et /en/experience.
 */
import Audiences from '../home/Audiences.astro';
import Badge from '../ui/Badge.astro';
import CallToAction from '../ui/CallToAction.astro';
import PageHeader from '../ui/PageHeader.astro';
import Section from '../ui/Section.astro';
import { getLocalizedEntries } from '../../lib/content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const experiences = await getLocalizedEntries('experiences', lang);
const hasPlaceholders = experiences.some(({ entry }) => entry.data.placeholder);
---

<PageHeader
  eyebrow={t('experiences.eyebrow')}
  title={t('experiences.heading')}
  intro={t('experiences.intro')}
  breadcrumbs={[{ label: t('experiences.title') }]}
/>

<Section
  id="missions"
  tone="paper"
  eyebrow={t('experiences.list.eyebrow')}
  title={t('experiences.list.title')}
  intro={hasPlaceholders ? t('experiences.list.intro') : undefined}
>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
    {experiences.map(({ entry, fallback }, index) => (
      <li
        data-reveal
        class="group flex flex-col rounded-md border border-navy-100 bg-paper p-8 shadow-sm shadow-navy-900/5 transition-shadow hover:shadow-md"
        style={`transition-delay: ${(index % 3) * 80}ms`}
        lang={fallback ? 'fr' : undefined}
      >
        <div class="flex items-center justify-between gap-3">
          <span class="font-display text-sm font-semibold tracking-[0.2em] text-gold-700">
            {String(index + 1).padStart(2, '0')}
          </span>
          {entry.data.placeholder && <Badge>{t('content.example')}</Badge>}
        </div>
        <div class="mt-6 h-px w-10 bg-gold-500 transition-all duration-300 group-hover:w-16"></div>
        {entry.data.client && (
          <p class="mt-6 text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
            {entry.data.client}
          </p>
        )}
        <h3 class="mt-3 text-xl leading-snug font-semibold text-navy-700">{entry.data.title}</h3>
        <p class="mt-4 flex-1 text-muted">{entry.data.summary}</p>
        {(entry.data.year || entry.data.location) && (
          <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-navy-100 pt-4 text-sm">
            {entry.data.year && (
              <div class="flex gap-2">
                <dt class="text-muted">{t('experience.year')}</dt>
                <dd class="font-medium text-navy-700">{entry.data.year}</dd>
              </div>
            )}
            {entry.data.location && (
              <div class="flex gap-2">
                <dt class="text-muted">{t('experience.location')}</dt>
                <dd class="font-medium text-navy-700">{entry.data.location}</dd>
              </div>
            )}
          </dl>
        )}
        {fallback && (
          <p lang="fr" class="mt-4 text-xs text-muted italic">
            {t('content.fallback')}
          </p>
        )}
      </li>
    ))}
  </ul>
  <!-- TODO(client): ajouter une rubrique « Partenaires institutionnels » (logos) quand la cliente les aura fournis -->
</Section>

<Audiences />

<CallToAction />
