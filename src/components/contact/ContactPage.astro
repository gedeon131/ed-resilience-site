---
/**
 * Page Contact, partagée par /contact et /en/contact :
 * canaux directs (e-mail, WhatsApp, rendez-vous, réseaux), formulaire de contact, demande de devis.
 */
import ContactForm from '../forms/ContactForm.astro';
import QuoteForm from '../forms/QuoteForm.astro';
import PageHeader from '../ui/PageHeader.astro';
import { bookingUrl, contactEmail, getWhatsAppHref, socialLinks } from '../../config/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const whatsappHref = getWhatsAppHref(t('whatsapp.message'));

const channelTitle = 'text-xs font-semibold tracking-[0.2em] text-gold-300 uppercase';
const channelLink =
  'mt-2 inline-flex items-center gap-2 text-base font-medium text-paper no-underline hover:text-gold-300';
---

<PageHeader
  eyebrow={t('contact.eyebrow')}
  title={t('contact.heading')}
  intro={t('contact.intro')}
  breadcrumbs={[{ label: t('contact.title') }]}
/>

<!-- Canaux directs + formulaire de contact -->
<section class="bg-paper" aria-labelledby="contact-form-titre">
  <div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4">
      <div class="relative overflow-hidden rounded-md bg-navy-900 p-8 text-navy-100 md:p-10 lg:sticky lg:top-36">
        <svg
          class="pointer-events-none absolute -right-20 -bottom-20 size-72 text-gold-300 opacity-10"
          viewBox="0 0 200 200"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          aria-hidden="true"
        >
          <circle cx="100" cy="100" r="95"></circle>
          <ellipse cx="100" cy="100" rx="45" ry="95"></ellipse>
          <ellipse cx="100" cy="100" rx="75" ry="95"></ellipse>
          <path d="M12 65h176M5 100h190M12 135h176"></path>
        </svg>
        <h2 class="font-display text-2xl text-paper">{t('contact.channels.title')}</h2>
        <span class="mt-5 block h-px w-10 bg-gold-500" aria-hidden="true"></span>

        <dl class="relative mt-8 space-y-8">
          <div>
            <dt class={channelTitle}>{t('contact.channels.email')}</dt>
            <dd>
              <a href={`mailto:${contactEmail}`} class:list={[channelLink, 'break-all']}>
                {contactEmail}
              </a>
            </dd>
          </div>

          {whatsappHref && (
            <div>
              <dt class={channelTitle}>{t('contact.channels.whatsapp')}</dt>
              <dd>
                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={channelLink}
                >
                  {t('contact.channels.whatsappAction')}
                  <span aria-hidden="true">→</span>
                </a>
              </dd>
            </div>
          )}

          <div>
            <dt class={channelTitle}>{t('contact.channels.booking')}</dt>
            <dd>
              {bookingUrl ? (
                <a
                  href={bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-2 rounded-md bg-gold-500 px-5 py-3 text-xs font-semibold tracking-[0.15em] text-navy-900 uppercase no-underline hover:bg-gold-300"
                >
                  {t('contact.channels.bookingAction')}
                  <span aria-hidden="true">→</span>
                </a>
              ) : (
                <p class="mt-2 text-sm text-navy-100/80">{t('contact.channels.bookingSoon')}</p>
              )}
            </dd>
          </div>

          {socialLinks.length > 0 && (
            <div>
              <dt class={channelTitle}>{t('contact.channels.social')}</dt>
              <dd class="mt-2 flex flex-wrap gap-4">
                {socialLinks.map(({ name, href }) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-paper no-underline hover:text-gold-300"
                  >
                    {name}
                  </a>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </aside>

    <div class="lg:col-span-8">
      <p class="mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
        <span class="h-px w-10 bg-current" aria-hidden="true"></span>
        {t('contact.form.eyebrow')}
      </p>
      <h2 id="contact-form-titre" class="text-3xl leading-tight md:text-4xl">
        {t('contact.form.title')}
      </h2>
      <p class="mt-4 mb-10 text-muted">{t('contact.form.intro')}</p>
      <ContactForm labelledby="contact-form-titre" />
    </div>
  </div>
</section>

<!-- Demande de devis -->
<section id="devis" class="scroll-mt-28 bg-navy-100" aria-labelledby="devis-titre">
  <div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-12">
    <header class="lg:col-span-4">
      <p class="mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
        <span class="h-px w-10 bg-current" aria-hidden="true"></span>
        {t('contact.quote.eyebrow')}
      </p>
      <h2 id="devis-titre" class="text-3xl leading-tight md:text-4xl">
        {t('contact.quote.title')}
      </h2>
      <p class="mt-4 text-muted">{t('contact.quote.intro')}</p>
    </header>
    <div class="rounded-md bg-paper p-6 shadow-sm shadow-navy-900/5 md:p-10 lg:col-span-8">
      <QuoteForm labelledby="devis-titre" />
    </div>
  </div>
</section>
