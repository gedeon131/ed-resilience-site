---
/**
 * Page À propos, partagée par /a-propos et /en/about.
 */
import Approach from '../services/Approach.astro';
import CallToAction from '../ui/CallToAction.astro';
import GlobeIllustration from '../ui/GlobeIllustration.astro';
import PageHeader from '../ui/PageHeader.astro';
import Section from '../ui/Section.astro';
import { getLangFromUrl, useTranslations, type UiKey } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const values = (['rigor', 'commitment', 'proximity', 'impact'] as const).map((key) => ({
  title: t(`value.${key}.title` as UiKey),
  text: t(`value.${key}.text` as UiKey),
}));
---

<PageHeader
  eyebrow={t('about.eyebrow')}
  title={t('about.heading')}
  intro={t('about.intro')}
  breadcrumbs={[{ label: t('about.title') }]}
/>

<!-- Mission et vision -->
<section class="bg-paper" aria-labelledby="mission-titre">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-16">
    <div data-reveal class="lg:col-span-7">
      <p class="mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
        <span class="h-px w-10 bg-current" aria-hidden="true"></span>
        {t('about.mission.eyebrow')}
      </p>
      <h2 id="mission-titre" class="text-3xl leading-[1.15] md:text-4xl lg:text-5xl">
        {t('about.mission.title')}
      </h2>
      <!-- PLACEHOLDER : mission et vision à rédiger par la cliente -->
      <p class="mt-8 text-base text-muted md:text-lg">{t('about.mission.text')}</p>
      <div class="mt-10 border-l-2 border-gold-500 pl-6">
        <h3 class="text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
          {t('about.vision.title')}
        </h3>
        <p class="mt-3 font-accent text-2xl leading-snug text-navy-700 italic md:text-3xl">
          {t('about.vision.text')}
        </p>
      </div>
    </div>
    <div data-reveal class="lg:col-span-5">
      <div class="rounded-md bg-navy-100/60 p-8 md:p-12">
        <GlobeIllustration class="mx-auto w-full max-w-md" label={t('about.illustrationAlt')} />
      </div>
    </div>
  </div>
</section>

<!-- Valeurs -->
<Section
  id="valeurs"
  tone="deep"
  eyebrow={t('about.values.eyebrow')}
  title={t('about.values.title')}
  intro={t('about.values.intro')}
>
  <!-- PLACEHOLDER : valeurs à confirmer avec la cliente -->
  <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {values.map(({ title, text }, index) => (
      <li
        data-reveal
        class="border-t border-gold-500/40 pt-8"
        style={`transition-delay: ${index * 80}ms`}
      >
        <span class="font-display text-sm font-semibold tracking-[0.2em] text-gold-300">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-4 font-display text-2xl font-semibold tracking-[0.06em] text-paper">
          {title}
        </h3>
        <p class="mt-3 text-navy-100/80">{text}</p>
      </li>
    ))}
  </ul>
</Section>

<!-- Fondatrice -->
<section class="bg-paper" aria-labelledby="fondatrice-titre">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-16">
    <div data-reveal class="lg:col-span-5">
      <!-- TODO(client): remplacer par la photo de la fondatrice (src/assets/images/fondatrice.jpg) -->
      <div
        class="relative mx-auto flex aspect-[4/5] max-w-sm items-center justify-center overflow-hidden rounded-md bg-navy-900"
        role="img"
        aria-label={t('about.founder.photoAlt')}
      >
        <svg
          class="absolute -right-16 -bottom-16 size-80 text-gold-300 opacity-10"
          viewBox="0 0 200 200"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          aria-hidden="true"
        >
          <circle cx="100" cy="100" r="95"></circle>
          <ellipse cx="100" cy="100" rx="45" ry="95"></ellipse>
          <ellipse cx="100" cy="100" rx="75" ry="95"></ellipse>
          <path d="M12 65h176M5 100h190M12 135h176"></path>
        </svg>
        <span class="font-display text-7xl font-semibold text-gold-300" aria-hidden="true">
          ED
        </span>
        <span class="absolute inset-x-8 bottom-8 h-px bg-gold-500/60" aria-hidden="true"></span>
      </div>
    </div>
    <div data-reveal class="lg:col-span-7">
      <p class="mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
        <span class="h-px w-10 bg-current" aria-hidden="true"></span>
        {t('about.founder.eyebrow')}
      </p>
      <h2 id="fondatrice-titre" class="text-3xl leading-tight md:text-5xl">
        {t('about.founder.name')}
      </h2>
      <p class="mt-3 text-sm font-semibold tracking-[0.15em] text-gold-700 uppercase">
        {t('about.founder.role')}
      </p>
      <!-- PLACEHOLDER : biographie à fournir par la cliente -->
      <p class="mt-8 text-base text-muted md:text-lg">{t('about.founder.bio')}</p>
      <p class="mt-8 font-accent text-xl text-navy-700 italic">{t('site.tagline')}</p>
    </div>
  </div>
</section>

<Approach tone="tint" />

<CallToAction />
