---
/**
 * Emblème « ED » vectoriel, redessiné d'après le logo fourni (JPEG) :
 * lettres ED en capitales romaines, globe doré dans la boucle du D, arc doré sous les lettres.
 * Version pour fond sombre : lettres claires (currentColor), éléments or.
 * TODO(client): faire valider ce tracé, ou le remplacer par le logo vectoriel officiel.
 */
interface Props {
  class?: string;
  /** Texte alternatif ; vide = décoratif (quand le nom est écrit à côté). */
  label?: string;
}

const { class: className, label } = Astro.props;
const id = `logo-or-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 120 80"
  fill="none"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <linearGradient id={id} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="var(--color-gold-700)"></stop>
      <stop offset="0.55" stop-color="var(--color-gold-300)"></stop>
      <stop offset="1" stop-color="var(--color-gold-500)"></stop>
    </linearGradient>
  </defs>

  <!-- E -->
  <path
    fill="currentColor"
    d="M6 8h34l1.5 13h-2.6C37.4 14 34 11.6 26.6 11.6H19v22.6h6.2c4.6 0 6.2-1.6 6.9-6.4h2.4v16.6h-2.4c-.7-4.8-2.3-6.6-6.9-6.6H19v20.6c0 2.4 1 3.3 3.6 3.3h4c7.8 0 11.4-2.8 13.4-10.4h2.6L41 64H6v-2.4c3.6-.4 4.7-1.4 4.7-4.6V15c0-3.2-1.1-4.2-4.7-4.6z"
  ></path>

  <!-- D -->
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="M50 8h22c19.6 0 33 11.2 33 28s-13.4 28-33 28H50v-2.4c3.6-.4 4.7-1.4 4.7-4.6V15c0-3.2-1.1-4.2-4.7-4.6zm13 3.8v48.4h8.6c13.8 0 23.6-9.4 23.6-24.2S85.4 11.8 71.6 11.8z"
  ></path>

  <!-- Globe dans la boucle du D -->
  <g stroke={`url(#${id})`} stroke-width="1.6" stroke-linecap="round">
    <circle cx="78" cy="36" r="13.5"></circle>
    <ellipse cx="78" cy="36" rx="6" ry="13.5"></ellipse>
    <path d="M64.8 31h26.4M64.5 36h27M64.8 41h26.4M78 22.5v27"></path>
  </g>

  <!-- Arc doré sous les lettres -->
  <path fill={`url(#${id})`} d="M3 76C24 58 60 50 112 54c-50-1.6-82 5.6-109 22z"></path>
</svg>
