---
import GoldDivider from './GoldDivider.astro';

/**
 * Section de page avec en-tête optionnel (surtitre, titre H2, filet or, introduction).
 * - layout « center » : en-tête centré
 * - layout « split » : titre à gauche, introduction à droite sur grand écran (style éditorial)
 */
type Tone = 'paper' | 'tint' | 'dark' | 'deep';

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  title?: string;
  intro?: string;
  layout?: 'center' | 'split';
  class?: string;
}

const {
  id,
  tone = 'paper',
  eyebrow,
  title,
  intro,
  layout = 'split',
  class: className,
} = Astro.props;

const dark = tone === 'dark' || tone === 'deep';

const tones: Record<Tone, string> = {
  paper: 'bg-paper text-text',
  tint: 'bg-navy-100 text-text',
  dark: 'bg-navy-900 text-navy-100',
  deep: 'bg-navy-800 text-navy-100',
};

const headingId = id ? `${id}-titre` : undefined;
const split = layout === 'split';
---

<section
  id={id}
  aria-labelledby={title ? headingId : undefined}
  class:list={['scroll-mt-24', tones[tone], className]}
>
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    {title && (
      <header
        data-reveal
        class:list={[
          'mb-12 md:mb-16',
          split
            ? 'grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12'
            : 'mx-auto max-w-3xl text-center',
        ]}
      >
        <div class:list={[split && 'lg:col-span-7']}>
          {eyebrow && (
            <p
              class:list={[
                'mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] uppercase',
                !split && 'justify-center',
                dark ? 'text-gold-300' : 'text-gold-700',
              ]}
            >
              <span class="h-px w-10 bg-current" aria-hidden="true"></span>
              {eyebrow}
            </p>
          )}
          <h2
            id={headingId}
            class:list={['text-3xl leading-[1.15] md:text-4xl lg:text-5xl', dark && 'text-paper']}
          >
            {title}
          </h2>
          {!split && <GoldDivider class="mt-6" />}
        </div>
        {intro && (
          <p
            class:list={[
              'text-base md:text-lg',
              split ? 'lg:col-span-5 lg:pb-2' : 'mt-6',
              dark ? 'text-navy-100/85' : 'text-muted',
            ]}
          >
            {intro}
          </p>
        )}
      </header>
    )}
    <slot />
  </div>
</section>
