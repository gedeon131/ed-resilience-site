---
import Button from '../ui/Button.astro';
import { contactEmail, getBookingLink } from '../../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contact = getLocalizedPath('contact', lang);
const booking = getBookingLink(t('home.cta.primary'), t('booking.newTab'), contact);
---

<section
  class="relative isolate overflow-hidden bg-navy-700 text-navy-100"
  aria-labelledby="cta-titre"
>
  <svg
    class="pointer-events-none absolute -top-40 -right-40 -z-10 size-[36rem] text-gold-300 opacity-[0.08]"
    viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
    stroke-width="0.6"
    aria-hidden="true"
  >
    <circle cx="100" cy="100" r="95"></circle>
    <ellipse cx="100" cy="100" rx="45" ry="95"></ellipse>
    <ellipse cx="100" cy="100" rx="75" ry="95"></ellipse>
    <path d="M12 65h176M5 100h190M12 135h176"></path>
  </svg>

  <div
    data-reveal
    class="mx-auto grid max-w-7xl gap-10 px-4 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:items-end"
  >
    <div class="lg:col-span-7">
      <h2 id="cta-titre" class="text-3xl leading-tight text-paper md:text-5xl">
        {t('home.cta.title')}
      </h2>
      <p class="mt-6 max-w-xl text-navy-100/90 md:text-lg">{t('home.cta.text')}</p>
      <a
        href={`mailto:${contactEmail}`}
        class="mt-6 inline-block text-sm break-all text-gold-300 no-underline hover:text-paper"
      >
        {contactEmail}
      </a>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
      <Button {...booking} variant="accent" size="lg">
        {t('home.cta.primary')}
        <span aria-hidden="true">→</span>
      </Button>
      <!-- TODO: ancre vers le formulaire de devis une fois la page Contact créée (étape 6) -->
      <Button href={`${contact}#devis`} variant="outline-light" size="lg">
        {t('home.cta.secondary')}
      </Button>
    </div>
  </div>
</section>
