---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import { getLocalizedEntries } from '../../lib/content';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [featured, ...others] = (await getLocalizedEntries('experiences', lang))
  .filter(({ entry }) => entry.data.featured)
  .slice(0, 3);
---

<Section
  id="experiences"
  tone="dark"
  eyebrow={t('home.experiences.eyebrow')}
  title={t('home.experiences.title')}
  intro={t('home.experiences.intro')}
>
  {featured && (
    <article
      data-reveal
      class="grid overflow-hidden rounded-md border border-gold-500/20 bg-navy-800 lg:grid-cols-2"
    >
      <!-- Visuel : emplacement prévu pour une photo de mission (à fournir par la cliente) -->
      <div
        class="relative min-h-56 overflow-hidden bg-[radial-gradient(circle_at_30%_40%,var(--color-navy-500)_0%,var(--color-navy-900)_70%)] lg:min-h-80"
        aria-hidden="true"
      >
        <svg
          class="absolute -bottom-24 -left-16 size-96 text-gold-300 opacity-15"
          viewBox="0 0 200 200"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
        >
          <circle cx="100" cy="100" r="95"></circle>
          <ellipse cx="100" cy="100" rx="45" ry="95"></ellipse>
          <ellipse cx="100" cy="100" rx="75" ry="95"></ellipse>
          <path d="M12 65h176M5 100h190M12 135h176"></path>
        </svg>
        <p class="absolute top-8 left-8 font-display text-sm font-semibold tracking-[0.25em] text-gold-300 uppercase">
          {t('home.experiences.featured')}
        </p>
      </div>
      <div class="flex flex-col justify-center p-8 md:p-12">
        <div class="mb-6 flex flex-wrap items-center gap-2">
          {featured.entry.data.placeholder && <Badge tone="dark">{t('content.example')}</Badge>}
          {featured.fallback && (
            <span lang="fr" class="text-xs text-navy-100/70 italic">
              {t('content.fallback')}
            </span>
          )}
        </div>
        {featured.entry.data.client && (
          <p class="text-xs font-semibold tracking-[0.2em] text-gold-300 uppercase">
            {featured.entry.data.client}
          </p>
        )}
        <h3 class="mt-4 text-2xl leading-snug font-semibold text-paper md:text-3xl">
          {featured.entry.data.title}
        </h3>
        <p class="mt-5 text-navy-100/85 md:text-lg">{featured.entry.data.summary}</p>
      </div>
    </article>
  )}

  <ul class="mt-6 grid gap-6 md:grid-cols-2" role="list">
    {others.map(({ entry, fallback }, index) => (
      <li
        data-reveal
        class="flex flex-col rounded-md border border-gold-500/20 bg-navy-800/60 p-8 transition-colors hover:border-gold-500/50"
        style={`transition-delay: ${index * 80}ms`}
      >
        <div class="mb-5 flex flex-wrap items-center gap-2">
          {entry.data.placeholder && <Badge tone="dark">{t('content.example')}</Badge>}
          {fallback && (
            <span lang="fr" class="text-xs text-navy-100/70 italic">
              {t('content.fallback')}
            </span>
          )}
        </div>
        {entry.data.client && (
          <p class="text-xs font-semibold tracking-[0.2em] text-gold-300 uppercase">
            {entry.data.client}
          </p>
        )}
        <h3 class="mt-3 text-xl font-semibold text-paper">{entry.data.title}</h3>
        <p class="mt-3 text-navy-100/80">{entry.data.summary}</p>
      </li>
    ))}
  </ul>

  <div class="mt-12">
    <Button href={getLocalizedPath('experiences', lang)} variant="outline-light">
      {t('home.experiences.all')}
      <span aria-hidden="true">→</span>
    </Button>
  </div>
</Section>
