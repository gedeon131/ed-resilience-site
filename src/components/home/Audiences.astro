---
import Section from '../ui/Section.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

// TODO(client): confirmer les publics visés (le questionnaire classe les 15-20 ans en premier, CLAUDE.md §7.3)
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const audiences = [
  {
    title: t('audience.public.title'),
    text: t('audience.public.text'),
    // Édifice public
    icon: 'M3 10l9-6 9 6M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18',
  },
  {
    title: t('audience.ngo.title'),
    text: t('audience.ngo.text'),
    // Mains / soutien
    icon: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  },
  {
    title: t('audience.private.title'),
    text: t('audience.private.text'),
    // Mallette
    icon: 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  },
  {
    title: t('audience.partners.title'),
    text: t('audience.partners.text'),
    // Globe
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.7 3.5 5.7 3.5 9s-1 6.3-3.5 9c-2.5-2.7-3.5-5.7-3.5-9s1-6.3 3.5-9z',
  },
];
---

<Section
  id="publics"
  tone="deep"
  eyebrow={t('home.audiences.eyebrow')}
  title={t('home.audiences.title')}
  intro={t('home.audiences.intro')}
>
  <!-- PLACEHOLDER : publics à confirmer avec la cliente -->
  <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {audiences.map(({ title, text, icon }, index) => (
      <li
        data-reveal
        class="border-t border-gold-500/40 pt-8"
        style={`transition-delay: ${index * 80}ms`}
      >
        <svg
          class="size-8 text-gold-300"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={icon} />
        </svg>
        <h3 class="mt-6 text-lg font-semibold text-paper">{title}</h3>
        <p class="mt-3 text-navy-100/80">{text}</p>
      </li>
    ))}
  </ul>
</Section>
