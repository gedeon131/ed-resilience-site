---
import { Picture } from 'astro:assets';
import logo from '../../assets/logo/logo-original.jpg';
import Button from '../ui/Button.astro';
import { getBookingLink } from '../../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="relative isolate flex min-h-svh flex-col overflow-hidden bg-ink text-navy-100"
  aria-labelledby="hero-titre"
>
  <!-- Halo marine : donne de la profondeur au fond noir du logo -->
  <div
    class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_10%_100%,var(--color-navy-800)_0%,transparent_60%),linear-gradient(to_bottom,var(--color-ink)_55%,var(--color-navy-900))]"
    aria-hidden="true"
  ></div>

  <!-- Globe en filigrane (portée internationale) -->
  <svg
    class="pointer-events-none absolute top-1/2 -right-48 -z-10 size-[46rem] -translate-y-1/2 text-gold-300 opacity-[0.06] md:-right-32 lg:size-[54rem]"
    viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
    stroke-width="0.5"
    aria-hidden="true"
  >
    <circle cx="100" cy="100" r="95"></circle>
    <ellipse cx="100" cy="100" rx="45" ry="95"></ellipse>
    <ellipse cx="100" cy="100" rx="75" ry="95"></ellipse>
    <line x1="100" y1="5" x2="100" y2="195"></line>
    <path d="M12 65h176M5 100h190M12 135h176"></path>
  </svg>

  <div class="mx-auto grid w-full max-w-7xl flex-1 items-center gap-10 px-4 pt-28 pb-12 md:px-8 md:pt-40 lg:grid-cols-12 lg:gap-12 lg:pt-44">
    <div class="hero-reveal order-2 lg:order-1 lg:col-span-7">
      <p class="mb-6 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-gold-300 uppercase">
        <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
        {t('home.hero.eyebrow')}
      </p>
      <h1
        id="hero-titre"
        class="text-4xl leading-[1.08] text-paper sm:text-5xl lg:text-6xl xl:text-7xl"
      >
        {t('home.hero.title')}
      </h1>
      <!-- PLACEHOLDER -->
      <p class="mt-8 max-w-xl text-base text-navy-100/85 md:text-lg">{t('home.hero.intro')}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={getLocalizedPath('services', lang)} variant="accent" size="lg">
          {t('home.hero.ctaPrimary')}
          <span aria-hidden="true">→</span>
        </Button>
        <Button
          {...getBookingLink(
            t('home.hero.ctaSecondary'),
            t('booking.newTab'),
            getLocalizedPath('contact', lang),
          )}
          variant="outline-light"
          size="lg"
        >
          {t('home.hero.ctaSecondary')}
        </Button>
      </div>
    </div>

    <!-- Logo JPEG sur fond noir : le mode « lighten » fond le noir dans le fond sombre du hero.
         Appliqué au conteneur, car l'animation crée un contexte d'empilement qui isolerait l'image. -->
    <div class="hero-reveal order-1 mx-auto w-full max-w-64 mix-blend-lighten sm:max-w-xs lg:order-2 lg:col-span-5 lg:max-w-none">
      <Picture
        src={logo}
        alt={t('home.hero.logoAlt')}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 1024px) 480px, (min-width: 640px) 320px, 256px"
        loading="eager"
        fetchpriority="high"
        class="aspect-[1.4] w-full object-cover"
      />
    </div>
  </div>

  <!-- Bandeau bas : signature et invitation à défiler -->
  <div class="relative border-t border-gold-500/20">
    <svg
      class="pointer-events-none absolute inset-x-0 -top-px h-px w-full"
      preserveAspectRatio="none"
      viewBox="0 0 100 1"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="filet-or" x1="0" x2="1">
          <stop offset="0" stop-color="var(--color-gold-700)" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="var(--color-gold-300)"></stop>
          <stop offset="1" stop-color="var(--color-gold-500)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <rect width="100" height="1" fill="url(#filet-or)"></rect>
    </svg>
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-5 md:px-8 md:py-6">
      <p class="font-accent text-lg text-gold-300 italic md:text-xl">{t('site.tagline')}</p>
      <a
        href="#piliers"
        class="group hidden items-center gap-3 text-xs font-semibold tracking-[0.2em] text-navy-100/80 uppercase no-underline hover:text-gold-300 sm:inline-flex"
      >
        {t('home.hero.scroll')}
        <span
          class="flex size-9 items-center justify-center rounded-full border border-gold-500/50 transition-transform group-hover:translate-y-0.5"
          aria-hidden="true"
        >
          ↓
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-reveal {
    animation: reveal 0.8s ease-out both;
  }

  .hero-reveal + .hero-reveal {
    animation-delay: 0.15s;
  }
</style>
