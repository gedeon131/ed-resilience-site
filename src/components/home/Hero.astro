---
import { Picture } from 'astro:assets';
import logo from '../../assets/logo/logo-original.jpg';
import Button from '../ui/Button.astro';
import GoldDivider from '../ui/GoldDivider.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="relative isolate overflow-hidden bg-linear-to-b from-ink via-ink to-navy-900 text-navy-100"
  aria-labelledby="hero-titre"
>
  <!-- Globe en filigrane (portée internationale) -->
  <svg
    class="pointer-events-none absolute top-1/2 -right-40 -z-10 size-[44rem] -translate-y-1/2 text-gold-300 opacity-[0.06] md:-right-24"
    viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
    stroke-width="0.6"
    aria-hidden="true"
  >
    <circle cx="100" cy="100" r="95"></circle>
    <ellipse cx="100" cy="100" rx="45" ry="95"></ellipse>
    <ellipse cx="100" cy="100" rx="75" ry="95"></ellipse>
    <line x1="100" y1="5" x2="100" y2="195"></line>
    <path d="M12 65h176M5 100h190M12 135h176"></path>
  </svg>

  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pt-12 pb-20 md:px-8 md:pt-16 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pt-20 lg:pb-28">
    <div class="hero-reveal order-2 text-center lg:order-1 lg:text-left">
      <p class="mb-5 text-xs font-semibold tracking-[0.2em] text-gold-300 uppercase">
        {t('home.hero.eyebrow')}
      </p>
      <h1 id="hero-titre" class="text-3xl leading-tight text-paper sm:text-4xl lg:text-5xl">
        {t('home.hero.title')}
      </h1>
      <GoldDivider align="center" class="mt-7 lg:hidden" />
      <GoldDivider align="left" class="mt-7 hidden lg:flex" />
      <!-- PLACEHOLDER -->
      <p class="mx-auto mt-7 max-w-xl text-base text-navy-100/85 md:text-lg lg:mx-0">
        {t('home.hero.intro')}
      </p>
      <div class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:justify-start">
        <Button href={getLocalizedPath('services', lang)} variant="accent" size="lg">
          {t('home.hero.ctaPrimary')}
        </Button>
        <Button href={getLocalizedPath('contact', lang)} variant="outline-light" size="lg">
          {t('home.hero.ctaSecondary')}
        </Button>
      </div>
    </div>

    <!-- Logo JPEG sur fond noir : le mode « lighten » fond le noir dans le fond sombre du hero.
         Appliqué au conteneur, car l'animation crée un contexte d'empilement qui isolerait l'image. -->
    <div class="hero-reveal order-1 mx-auto w-full max-w-72 mix-blend-lighten sm:max-w-sm lg:order-2 lg:max-w-lg">
      <Picture
        src={logo}
        alt={t('home.hero.logoAlt')}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 1024px) 512px, (min-width: 640px) 384px, 288px"
        loading="eager"
        fetchpriority="high"
        class="aspect-[1.4] w-full object-cover"
      />
    </div>
  </div>

  <!-- Arc doré, repris de la courbe sous les lettres ED -->
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-24 w-full md:h-32"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    fill="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="arc-or" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="var(--color-gold-700)" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="var(--color-gold-300)" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="var(--color-gold-500)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <path d="M0 118 Q720 -10 1440 118" stroke="url(#arc-or)" stroke-width="1.5"></path>
  </svg>
</section>

<style>
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-reveal {
    animation: reveal 0.7s ease-out both;
  }

  .hero-reveal + .hero-reveal {
    animation-delay: 0.15s;
  }
</style>
