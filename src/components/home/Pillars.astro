---
import Section from '../ui/Section.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  {
    key: 'risk',
    title: t('pillar.risk.title'),
    subtitle: t('pillar.risk.subtitle'),
    text: t('pillar.risk.text'),
    // Bouclier
    icon: 'M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3zM12 8v4M12 15.5v.5',
  },
  {
    key: 'resilience',
    title: t('pillar.resilience.title'),
    subtitle: t('pillar.resilience.subtitle'),
    text: t('pillar.resilience.text'),
    // Colonnes d'un édifice institutionnel
    icon: 'M3 9l9-5 9 5M5 9v9M10 9v9M14 9v9M19 9v9M3 20h18',
  },
  {
    key: 'recovery',
    title: t('pillar.recovery.title'),
    subtitle: t('pillar.recovery.subtitle'),
    text: t('pillar.recovery.text'),
    // Flèche de reprise
    icon: 'M4 12a8 8 0 0 1 14-5.3M20 4v5h-5M20 12a8 8 0 0 1-14 5.3M4 20v-5h5',
  },
];
---

<Section
  id="piliers"
  tone="paper"
  eyebrow={t('home.pillars.eyebrow')}
  title={t('home.pillars.title')}
  intro={t('home.pillars.intro')}
>
  <ul class="grid divide-y divide-gold-500/30 md:grid-cols-3 md:divide-x md:divide-y-0" role="list">
    {pillars.map(({ title, subtitle, text, icon }) => (
      <li class="px-2 py-10 text-center first:pt-0 last:pb-0 md:px-10 md:py-0">
        <span class="mx-auto mb-6 flex size-14 items-center justify-center rounded-full border border-gold-500/50 text-gold-500">
          <svg
            class="size-7"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={icon} />
          </svg>
        </span>
        <h3 class="font-display text-xl font-semibold tracking-[0.12em] text-navy-700 uppercase">
          {title}
        </h3>
        <p class="mt-2 text-xs font-semibold tracking-[0.2em] text-gold-700 uppercase">
          {subtitle}
        </p>
        <p class="mx-auto mt-4 max-w-xs text-muted">{text}</p>
      </li>
    ))}
  </ul>
</Section>
