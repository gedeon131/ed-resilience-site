---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { contactEmail } from '../../config/site';
import {
  getCurrentPath,
  getLangFromUrl,
  getLocalizedPath,
  getRoutePath,
  useTranslations,
  type RouteKey,
  type UiKey,
} from '../../i18n/utils';

interface Props {
  /** Transparent au-dessus du hero, opaque dès que la page défile. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items: { key: RouteKey; label: UiKey }[] = [
  { key: 'home', label: 'nav.home' },
  { key: 'about', label: 'nav.about' },
  { key: 'services', label: 'nav.services' },
  { key: 'experiences', label: 'nav.experiences' },
  { key: 'contact', label: 'nav.contact' },
];

const current = getCurrentPath(Astro.url);

const links = items.map(({ key, label }) => {
  const href = getLocalizedPath(key, lang);
  const target = getRoutePath(key, lang);
  const isHome = key === 'home';
  const active = isHome
    ? current === target
    : current === target || current.startsWith(`${target}/`);
  return { href, label: t(label), active };
});

const ctaHref = getLocalizedPath('contact', lang);
---

<header
  class:list={[
    'site-header top-0 z-40 w-full border-b border-gold-500/20 bg-navy-900/95 backdrop-blur transition-colors duration-300',
    overlay ? 'fixed' : 'sticky',
  ]}
  data-overlay={overlay ? '' : undefined}
>
  <a
    href="#contenu"
    class="sr-only rounded-md bg-gold-300 px-4 py-2 text-sm font-medium text-navy-900 focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
  >
    {t('nav.skip')}
  </a>

  <!-- Barre utilitaire (grands écrans) -->
  <div class="hidden border-b border-gold-500/15 md:block">
    <div class="mx-auto flex h-9 max-w-7xl items-center justify-between px-4 text-[0.6875rem] text-navy-100/75 md:px-8">
      <p class="tracking-[0.25em] uppercase">{t('site.pillars')}</p>
      <a
        href={`mailto:${contactEmail}`}
        class="tracking-[0.05em] text-navy-100/75 no-underline transition-colors hover:text-gold-300"
      >
        {contactEmail}
      </a>
    </div>
  </div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:h-20 md:px-8">
    <a href={getLocalizedPath('home', lang)} class="group flex items-center gap-3 no-underline">
      <span
        class="flex size-10 items-center justify-center rounded-md border border-gold-500/50 font-display text-lg font-semibold text-gold-300 md:size-11"
        aria-hidden="true"
      >
        ED
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-sm font-semibold tracking-[0.08em] text-paper md:text-base">
          ED Resilience
        </span>
        <span class="text-[0.625rem] tracking-[0.3em] text-gold-300 uppercase">Consulting</span>
      </span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {links.map(({ href, label, active }) => (
          <li>
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative py-2 text-xs font-medium tracking-[0.2em] uppercase no-underline transition-colors',
                'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-gold-500 after:transition-transform',
                active
                  ? 'text-gold-300 after:scale-x-100'
                  : 'text-navy-100 after:scale-x-0 hover:text-paper hover:after:scale-x-100',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={ctaHref}
        class="hidden rounded-md bg-gold-500 px-4 py-2.5 text-xs font-semibold tracking-[0.15em] text-navy-900 uppercase no-underline transition-colors hover:bg-gold-300 md:inline-flex"
      >
        {t('nav.cta')}
      </a>
      <LanguageSwitcher />
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-md text-paper hover:text-gold-300 lg:hidden"
        aria-controls="menu-mobile"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('nav.menu.open')}
        data-label-close={t('nav.menu.close')}
      >
        <span class="sr-only" data-menu-label>
          {t('nav.menu.open')}
        </span>
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path data-menu-icon="open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path
            data-menu-icon="close"
            class="hidden"
            stroke-linecap="round"
            d="M6 6l12 12M18 6L6 18"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    aria-label={t('nav.main')}
    class="hidden border-t border-gold-500/20 bg-navy-900 lg:hidden"
    data-menu-panel
  >
    <ul class="mx-auto flex max-w-7xl flex-col px-4 py-4">
      {links.map(({ href, label, active }) => (
        <li>
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'block border-b border-navy-800 py-3 text-sm font-medium tracking-[0.2em] uppercase no-underline',
              active ? 'text-gold-300' : 'text-navy-100 hover:text-paper',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-4 md:hidden">
        <a
          href={ctaHref}
          class="block rounded-md bg-gold-500 px-4 py-3 text-center text-xs font-semibold tracking-[0.15em] text-navy-900 uppercase no-underline hover:bg-gold-300"
        >
          {t('nav.cta')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const label = toggle.querySelector<HTMLElement>('[data-menu-label]');
    const iconOpen = toggle.querySelector('[data-menu-icon="open"]');
    const iconClose = toggle.querySelector('[data-menu-icon="close"]');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.closest('header')?.toggleAttribute('data-menu-open', open);
      panel.classList.toggle('hidden', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (label) {
        label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Header superposé : devient opaque dès que la page défile
  const header = document.querySelector<HTMLElement>('.site-header[data-overlay]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header[data-overlay]:not([data-scrolled]):not([data-menu-open]) {
    background-color: transparent;
    border-color: transparent;
    backdrop-filter: none;
  }
</style>
