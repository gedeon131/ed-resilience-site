---
/**
 * « Notre approche » : quatre étapes numérotées, du diagnostic à l'autonomie.
 */
import Section from '../ui/Section.astro';
import { getLangFromUrl, useTranslations, type UiKey } from '../../i18n/utils';

interface Props {
  tone?: 'paper' | 'tint';
}

const { tone = 'tint' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = ([1, 2, 3, 4] as const).map((n) => ({
  title: t(`approach.step${n}.title` as UiKey),
  text: t(`approach.step${n}.text` as UiKey),
}));
---

<Section
  id="approche"
  tone={tone}
  eyebrow={t('approach.eyebrow')}
  title={t('approach.title')}
  intro={t('approach.intro')}
>
  <!-- PLACEHOLDER : étapes de méthode à valider avec la cliente -->
  <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {steps.map(({ title, text }, index) => (
      <li
        data-reveal
        class:list={[
          'relative flex flex-col rounded-md border p-7',
          tone === 'tint' ? 'border-transparent bg-paper' : 'border-navy-100 bg-navy-100/40',
        ]}
        style={`transition-delay: ${index * 80}ms`}
      >
        <span
          class="flex size-11 items-center justify-center rounded-md bg-navy-700 font-display text-lg font-semibold text-gold-300"
          aria-hidden="true"
        >
          {index + 1}
        </span>
        <h3 class="mt-6 text-lg font-semibold text-navy-700">{title}</h3>
        <p class="mt-3 text-muted">{text}</p>
        {index < steps.length - 1 && (
          <span
            class="absolute top-12 -right-4 hidden h-px w-8 bg-gold-500/60 lg:block"
            aria-hidden="true"
          ></span>
        )}
      </li>
    ))}
  </ol>
</Section>
