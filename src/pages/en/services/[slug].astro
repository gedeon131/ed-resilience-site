---
import ServiceDetail from '../../../components/services/ServiceDetail.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedEntries, type LocalizedEntry } from '../../../lib/content';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  // Inclut les services sans traduction anglaise (version française affichée avec une mention)
  const services = await getLocalizedEntries('services', 'en');
  return services.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
  item: LocalizedEntry<'services'>;
}

const { item } = Astro.props;
const t = useTranslations('en');
const whatsappMessage = t('whatsapp.messageService').replace('{service}', item.entry.data.title);
---

<BaseLayout
  title={item.entry.data.title}
  description={item.entry.data.summary}
  whatsappMessage={whatsappMessage}
>
  <ServiceDetail item={item} />
</BaseLayout>
